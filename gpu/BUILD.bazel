# The TegraGM20B Metal plugin bundle for iOS 17 (arm64): the GPU userland of the Switch's GM20B.
#
#   bazel build //gpu:base          IPSW-free: ngpu/addons/TegraGM20BMetal.bundle, TegraGM20BMetal.trustcache, trust.json
#   bazel build //gpu:bundle        what deploy stages: base + the shader seed and the raw pack (//gpu/seed, which reads
#                                   the IPSW's Metal libraries), as a manifest over their outputs in deploy's runfiles
#   bazel build //gpu:trustcache    only the trust-cache module the boot package appends (both CDHashes)
#   bazel build //gpu:plugin --output_groups=debug   the plugin's dSYM
#
# Inputs: m2v's translator (third_party/m2v: steelbrain/metal2vulkan 720ef1ce and our patches as commits), its crates.io
# crates (@rust_crates, bazel/rust), Rust 1.98.0 (a pinned download), Xcode and NAK's stage compile.

load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/rust:defs.bzl", "cargo_ids", "rust_artifact")
load("//kits/SwitchGM20BEmit:defs.bzl", "EMIT_SOURCES")
load("//translate/arm64e:target.bzl", "a64x_target_linkopts")
load(":defs.bzl", "gpu_stage", "gpu_tree", "metal_bundle", "metal_plugin", "raw_stack")

package(default_visibility = ["//visibility:public"])

lint_files()

GM20B_METAL = "//drivers/TegraGM20BMetal"

TRANSLATE = GM20B_METAL + ":translate/"

# The selected IPSW kind's Metal.framework facts (drivers/TegraGM20BMetal/abi).
METAL_ABI = GM20B_METAL + "/abi:MetalABI.h"

GM20B_ABI = "//drivers/TegraGM20B:TegraGM20BABI.h"

GM20B_LAYOUT = "//drivers/TegraGM20B:TegraGM20BLayout.h"

# The stage compile (NAK, with no Vulkan device) the raw path makes records with: one object, its entry points its only
# global symbols (third_party/mesa/src/nouveau/switch_compile).
COMPILE = "//third_party/mesa/src/nouveau/switch_compile:ios"

# The selected IPSW build's compile profile: the GM20B device description and compile policy the translation's offline
# compile makes its translator devices of (translate/NativeMetalOffline.rs). Another build needs its own.
alias(
    name = "compile_profile",
    actual = select({
        "//ipsw:21H461": TRANSLATE + "compile_profile/21H461.json",
        "//ipsw:24B119": TRANSLATE + "compile_profile/24B119.json",
    }),
)

# The raw path's direct compile with no m2v runtime (drivers/TegraGM20BMetal/translate/NativeMetalTranslate.rs): the translator's own libraries,
# functions and compile devices (the build's compile profile, which it compiles in), what the pack generator and the shader
# compiler daemon compile with.
rust_library(
    name = "translate",
    srcs = [
        TRANSLATE + "NativeMetalTranslate.rs",
        TRANSLATE + "NativeMetalAddressMaps.rs",
        TRANSLATE + "NativeMetalArgumentLayouts.rs",
        TRANSLATE + "NativeMetalDescriptors.rs",
        TRANSLATE + "NativeMetalDirect.rs",
        TRANSLATE + "NativeMetalDirectCompute.rs",
        TRANSLATE + "NativeMetalDirectTess.rs",
        TRANSLATE + "NativeMetalKernelTextures.rs",
        TRANSLATE + "NativeMetalOffline.rs",
        TRANSLATE + "NativeMetalReflection.rs",
        TRANSLATE + "NativeMetalTessModes.rs",
    ],
    compile_data = [":compile_profile"],
    crate_name = "native_metal_translate",
    crate_root = TRANSLATE + "NativeMetalTranslate.rs",
    edition = "2024",
    rustc_env = {"NMB_COMPILE_PROFILE": "$(execpath :compile_profile)"},
    # target_j181: iOS 27's A13, whose render stages bind 128 textures (NativeMetalDirect.rs MAX_WRITES)
    rustc_flags = cargo_ids("5b1c2e7f0a9d4e63", "8f2a6c1d3e5b7094") + ["--check-cfg=cfg(target_j181)"] + select({
        "//ipsw:24B119": ["--cfg=target_j181"],
        "//conditions:default": [],
    }),
    version = "0.1.0",
    deps = [
        "//kits/SwitchRefusal:switch_refusal_rs",
        "//third_party/m2v/crates/metal2vulkan",
        "@rust_crates//:ash",
        "@rust_crates//:serde",
        "@rust_crates//:serde_json",
    ],
)

# The translate crate's unit tests, built for this build's identity (target_j181 on 24B119)
rust_test(
    name = "translate_test",
    crate = ":translate",
    rustc_flags = ["--check-cfg=cfg(target_j181)"] + select({
        "//ipsw:24B119": ["--cfg=target_j181"],
        "//conditions:default": [],
    }),
)

# The translate crate alone as a static library: the pack tools' (no m2v runtime in them).
rust_static_library(
    name = "translate_static",
    srcs = [TRANSLATE + "NativeMetalTranslateStatic.rs"],
    crate_name = "native_metal_translate_static",
    crate_root = TRANSLATE + "NativeMetalTranslateStatic.rs",
    edition = "2024",
    deps = [":translate"],
)

rust_artifact(
    name = "translate_host",
    crate = ":translate_static",
    kind = "tool",
)

# The device's: the translation the plugin links
rust_artifact(
    name = "translate_ios",
    crate = ":translate_static",
    kind = "device",
)

# The raw GM20B path's stack key: compiled into the plugin and stamped into the raw pack and the native seed, whose
# records a plugin of another key refuses, and naming each process's record cache. What a record is made and read by
# (gpu/defs.bzl raw_stack), so an edit to the rest of the raw runtime keeps every record made.
raw_stack(
    name = "raw_stack",
    srcs = [
        GM20B_METAL + ":raw_stack_sources",
        GM20B_METAL + ":translate_rust",
    ],
    bridge = ":translate",
    compile = COMPILE,
    include_markers = [
        GM20B_METAL + ":plugin/MetallibSlice.h",
        GM20B_ABI,
        "//kits/SwitchGM20BEmit:context",
        # where NVIDIA's class headers find "nvtypes.h" (raw/pack/nvdec.cpp)
        "//third_party/mesa/src/nouveau/headers:nvtypes.h",
    ],
    metal_abi = METAL_ABI,
    readers = [GM20B_METAL + ":raw/runtime/raw_completed.cpp"],
)

# The paths the stack key hashes (tools/gpu/raw_stack_test.py)
filegroup(
    name = "raw_stack_inputs",
    srcs = [":raw_stack"],
    output_group = "inputs",
)

