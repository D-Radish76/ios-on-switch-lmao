PLUGIN_FRAMEWORKS = [
    "Foundation",
    "Metal",
    "IOSurface",
    "IOKit",
]

PLUGIN_INCLUDE_MARKERS = [
    GM20B_METAL + ":plugin/SwitchFrameTimeline.h",
    METAL_ABI,
    GM20B_METAL + ":raw/runtime/RawMetal.h",
    GM20B_ABI,
    "//kits/SwitchRefusal:SwitchRefusal.h",
    # the kit's nv_push.h ahead of Mesa's own, in the directory NVIDIA's headers find "nvtypes.h" in
    "//kits/SwitchGM20BEmit:mesa/nv_push.h",
    "//kits/SwitchGM20BEmit:gen/nv_push_clb197.h",
    "//third_party/mesa/src/nouveau/headers:nvtypes.h",
    # the generated capability table (raw_device_answers.h chipFeature)
    "//kits/SwitchGM20B:SwitchGM20BCaps.h",
]

metal_plugin(
    name = "plugin",
    srcs = PLUGIN_SRCS,
    hdrs = PLUGIN_HDRS,
    c_srcs = ["//kits/SwitchGM20BEmit:" + s for s in EMIT_SOURCES] + ["//kits/SwitchRefusal:SwitchRefusal.c"],
    cc_srcs = PLUGIN_CC_SRCS,
    compile = COMPILE,
    frameworks = PLUGIN_FRAMEWORKS,
    include_markers = PLUGIN_INCLUDE_MARKERS,
    linkopts = a64x_target_linkopts(),
    stack = ":raw_stack",
    translate = ":translate_ios",
)

metal_bundle(
    name = "signed",
    plugin = ":plugin",
    stack = ":raw_stack",
    translate_header = TRANSLATE + "NativeMetalTranslate.h",
)

filegroup(
    name = "trustcache",
    srcs = [":signed"],
    output_group = "trustcache",
)

filegroup(
    name = "trust_json",
    srcs = [":signed"],
    output_group = "trust_json",
)

filegroup(
    name = "signed_bundle",
    srcs = [":signed"],
    output_group = "bundle",
)

gpu_tree(
    name = "base",
    bundle = ":signed_bundle",
    trust_json = ":trust_json",
    trustcache = ":trustcache",
)

gpu_stage(
    name = "bundle",
    base = ":base",
    raw = "//gpu/seed:raw_pack",
    seed = "//gpu/seed:seed",
    tags = ["manual"],
)

# The deleted Metal-to-Vulkan fallback's packages: m2v's runtime crate, Mesa's Vulkan driver and its dylibs, the Metal
# bridge and its frontend
FALLBACK = (
    "^//(drivers/NativeMetal|gpu/m2v_link|gpu/nvk|third_party/m2v/crates/metal2vulkan-runtime|" +
    "third_party/mesa/src/nouveau/vulkan)[:/]|^//gpu:bridge"
)

# What ships, and what builds the raw pack
SHIPPED = [
    "//apps/hwtest:SwitchHWTest17",
    "//apps/hwtest:SwitchHWTest27",
    "//apps/hwtest:SwitchHWTest27e",
    "//apps/hwtest:switch-texpeer",
    "//drivers/TegraGM20BMetal:SwitchShaderCompiler",
    "//gpu:base",
    "//gpu:plugin",
    "//gpu/seed:local_tools",
]

# Every target of their graphs, in every select() branch, in one of the fallback's packages
genquery(
    name = "fallback_deps",
    expression = 'filter("{}", deps({}))'.format(
        FALLBACK,
        " + ".join(SHIPPED),
    ),
    scope = SHIPPED,
)

py_test(
    name = "no_fallback_test",
    srcs = ["no_fallback_test.py"],
    args = ["$(rootpath :fallback_deps)"],
    data = [":fallback_deps"],
)
