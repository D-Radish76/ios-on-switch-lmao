load("@rules_rust//rust:defs.bzl", "rust_test")

# drivers/NativeMetal on the host, what goes with it (with the cut):
#   native_variants_test        bridge/NativeMetalVariants.rs's own tests
#   native_artifact_cache_test  NativeMetalArtifactCache.h, which only the frontend includes
#   async_pipelines_test        AsyncPipelines.h, the frontend's
#
#   bazel test //drivers/NativeMetal/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_test")

lint_files()

rust_test(
    name = "native_variants_test",
    srcs = ["//drivers/NativeMetal:bridge/NativeMetalVariants.rs"],
    edition = "2024",
)

host_test(
    name = "native_artifact_cache_test",
    srcs = [
        "native_artifact_cache_test.cpp",
        "//drivers/NativeMetal:NativeMetalArtifactCache.h",
        "//kits/SwitchSeedPack:SwitchSeedPack.h",
    ],
    cxx_std = "c++17",
)

[host_test(
    name = name,
    srcs = [
        "async_pipelines_test.cpp",
        "//drivers/NativeMetal:AsyncPipelines.h",
    ],
    copts = [
        "-x",
        "objective-c++",
        "-fobjc-arc",
    ] + defines,
    cxx_std = "c++17",
    linkopts = [
        "-framework",
        "Foundation",
    ],
) for name, defines in [
    ("async_pipelines_test", []),
    (
        "async_pipelines_release_test",
        ["-DSWITCH_DEBUG=0"],
    ),
]]
