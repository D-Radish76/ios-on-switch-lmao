load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load(":defs.bzl", "switch_wlan_a3_payload")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files([
    "abi.h",
    "beacon.h",
    "diagnostic.h",
    "fault.h",
    "image.h",
    "wire.h",
])

py_binary(
    name = "payload_header",
    srcs = ["payload_header.py"],
)

_PAYLOAD_SRCS = [
    "ack.c",
    "ack_symbols.S",
    "bootstrap.S",
    "bootstrap.c",
    "clock.c",
    "control.c",
    "rom.c",
    "rx.S",
    "rx.c",
    "rx_symbols.S",
    "timer.c",
    "timer_symbols.S",
]

_PAYLOAD_HDRS = [
    "abi.h",
    "ack.h",
    "clock.h",
    "control.h",
    "beacon.h",
    "diagnostic.h",
    "fault.h",
    "rom.h",
    "rx.h",
    "rx_status.h",
    "timer.h",
    "wire.h",
]

switch_wlan_a3_payload(
    name = "bootstrap",
    srcs = _PAYLOAD_SRCS,
    hdrs = _PAYLOAD_HDRS,
    development = True,
    header = "payload.h",
    link_script = "bootstrap.ld",
)

switch_wlan_a3_payload(
    name = "bootstrap_release",
    srcs = _PAYLOAD_SRCS,
    hdrs = _PAYLOAD_HDRS,
    header = "payload_release.h",
    link_script = "bootstrap.ld",
)

_CANDIDATE_SRCS = [
    "beacon.c",
    "candidate_control.c",
    "channel.c",
    "channel_gate.S",
    "channel_symbols.S",
    "diagnostic.c",
    "excursion.c",
    "excursion_symbols.S",
    "pm_status.S",
    "pm.S",
    "pm_symbols.S",
    "rom_candidate.c",
    "scheduler.c",
    "tx.S",
    "tx.c",
    "tx_timing.c",
    "tx_symbols.S",
]

_CANDIDATE_HDRS = [
    "channel.h",
    "excursion.h",
    "scheduler.h",
    "tx.h",
    "tx_timing.h",
]

_CANDIDATE_ROOTS = [
    "switch_a3_channel_gate",
    "switch_a3_pm_status_entry",
    "switch_a3_pm_prepare_entry",
    "switch_a3_pm_submit_entry",
    "switch_a3_pm_set_entry",
    "switch_a3_tx_entry",
    "switch_a3_tx_radio_status",
]

_CANDIDATE_BASE = [source for source in _PAYLOAD_SRCS if source not in [
    "control.c",
    "rom.c",
]]

switch_wlan_a3_payload(
    name = "candidate",
    srcs = _CANDIDATE_BASE + _CANDIDATE_SRCS,
    hdrs = _PAYLOAD_HDRS + _CANDIDATE_HDRS,
    candidate = True,
    development = True,
    header = "payload_candidate.h",
    link_script = "candidate.ld",
    lto = True,
    retain_symbols = _CANDIDATE_ROOTS,
)

switch_wlan_a3_payload(
    name = "candidate_release",
    srcs = _CANDIDATE_BASE + _CANDIDATE_SRCS,
    hdrs = _PAYLOAD_HDRS + _CANDIDATE_HDRS,
    candidate = True,
    header = "payload_candidate_release.h",
    link_script = "candidate.ld",
    lto = True,
    retain_symbols = _CANDIDATE_ROOTS,
)

