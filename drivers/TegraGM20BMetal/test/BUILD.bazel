# The system shader compiler's engine (compiler/compiler_engine.mm, the translator alone: raw/runtime/RawOffline.h), each
# run a process of its own: what it holds as it serves boot 12's requests, and a library of grouped pointers
[host_test(
    name = name,
    size = "medium",
    srcs = [name + ".cpp"] + headers + [
        ":compiler_engine_units",
