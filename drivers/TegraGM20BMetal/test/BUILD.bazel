# The raw facade and runtime with the host tests' sanitizers and the harness marks, the translation answered by
# raw_translate_absent.cpp: what raw_facade_arguments_test and raw_facade_heap_use_test open the facade over the kernel
# model with
FACADE_HOST_COPTS = RAW_HOST_COPTS + ["-DSWITCH_RAW_HARNESS_MARKS"]

FACADE_HOST_DEPS = RAW_HOST_DEPS + [
    "//kits/SwitchGM20B:classes",
    "//kits/SwitchGM20BEmit:emit_ndebug",
    "//kits/SwitchRefusal:switch_refusal",
]

# The same facade and runtime as //gpu:plugin builds them, with no sanitizers or harness marks (raw_facade_harness.h's m2v
# and footprint tests): the facade's Objective-C++ units through .cpp units of their own (defs.bzl) beside the shader
# compiler's, the translation answered by each test's raw_translate_absent.cpp
objcxx_units(
    name = "raw_facade_units",
    testonly = True,
    srcs = [
        "//drivers/TegraGM20BMetal:compiler_srcs",
        "//drivers/TegraGM20BMetal:raw_facade_srcs",
    ],
)

host_library(
    name = "raw_facade_plugin_host",
    srcs = [":raw_facade_units"],
    additional_compiler_inputs = [
        "//drivers/TegraGM20BMetal:compiler_srcs",
        "//drivers/TegraGM20BMetal:raw_facade_srcs",
    ] + RAW_HOST_HEADERS,
    copts = [
        "-x",
        "objective-c++",
        "-fobjc-arc",
        # an included .mm is a header to clang, which asks a header that annotates some pointers to annotate them all
        "-Wno-nullability-completeness",
        "-Wno-nullability-completeness-on-arrays",
    ] + RAW_HOST_COPTS,
    cxx_std = "c++17",
    sanitize = False,
    deps = RAW_HOST_DEPS,
)

host_library(
    name = "raw_runtime_plugin_host",
    srcs = RAW_HOST_UNITS + RAW_HOST_HEADERS,
    copts = RAW_HOST_COPTS,
    cxx_std = "c++17",
    sanitize = False,
    deps = RAW_HOST_DEPS + ["//kits/SwitchGM20BEmit:emit_ndebug"],
)

# The plugin's flags for the facade (gpu/defs.bzl _PLUGIN_CFLAGS: ARC, objc_library's default, and warnings as errors) and
# the host tests' sanitizers, with host_library's toolchain features (asan drops apple_support's -D_FORTIFY_SOURCE=1)
FACADE_OBJC_COPTS = FACADE_HOST_COPTS + WARNINGS + SANITIZERS + [
    "-std=c++17",
    "-g",
]

FACADE_OBJC_FEATURES = [
    "asan",
    "ubsan",
    "external_include_paths",
]

objc_library(
    name = "raw_facade_host",
    testonly = True,
    srcs = RAW_HOST_HEADERS + [
        "raw_translate_absent.cpp",
        "//drivers/TegraGM20BMetal:raw_facade_srcs",
    ],
    copts = FACADE_OBJC_COPTS,
    features = FACADE_OBJC_FEATURES,
    sdk_frameworks = [
        "CoreFoundation",
        "Foundation",
        "IOKit",
        "IOSurface",
        "Metal",
    ],
    deps = FACADE_HOST_DEPS + [":raw_runtime_host"],
    alwayslink = True,
)

# The facade over the kernel model (raw_facade_harness.h). raw_facade_arguments_test: its MTLArgumentEncoder over
# descriptors and its refusals, and the gpuResourceID of its textures and samplers,
# named at the first ask and forgotten when they go. raw_facade_heap_use_test: useHeap on its render and compute encoders
# is one use of the heap in the plan and of its arena in each job at 4 and 404 textures, host-written for a shared heap;
# a heap texture either encoder uses alone names its own range. raw_facade_probe_test: a 2D-engine probe op's textures are
# uses of its blit encoder. Each test's unit holds the kernel model's IOKit calls.
[objc_library(
    name = name + "_unit",
    testonly = True,
    srcs = RAW_HOST_HEADERS + [
        name + ".mm",
        "empty_pack.h",
        "made_metallib.h",
        "predication_model.h",
        "raw_device_harness.h",
        "raw_facade_harness.h",
        "raw_job_methods.h",
        "raw_kernel_model.h",
    ],
    copts = FACADE_OBJC_COPTS,
    features = FACADE_OBJC_FEATURES,
    deps = FACADE_HOST_DEPS + [
        ":raw_facade_host",
        "//kits/SwitchGM20BEmit/test:method_checks",
        "@googletest//:gtest",
    ],
    alwayslink = True,
) for name in [
    "raw_facade_arguments_test",
    "raw_facade_heap_use_test",
    "raw_facade_probe_test",
]]

[host_test(
    name = name,
    srcs = ["raw_facade_harness.h"],
    linkopts = [
        "-lobjc",
    ],
    deps = [":%s_unit" % name],
) for name in [
    "raw_facade_arguments_test",
    "raw_facade_heap_use_test",
    "raw_facade_probe_test",
]]

