            "@ipsw//:crawl_qc",
            "@ipsw//:crawl_tree",
        ],
        {
            "SWITCH_BOOT12": "$(rootpath compiler_boot12.log)",
            "SWITCH_QUARTZCORE": "$(rootpath @ipsw//:crawl_qc)",
        },
    ),
    (
        "compiler_groups_test",
        ["empty_pack.h"],
        ["//tools/gpu/maxwell:direct_runner"],
        {"SWITCH_GROUPED_METALLIB": "$(rootpath //tools/gpu/maxwell:direct_runner)/grouped-pointer.metallib"},
    ),
]]

# The engine as the plugin's units link it, each run a process of its own:
#   compiler_compile_only_test  a record of every kind a sample of the corpus's states asks, and each sampled kernel's
#                               reflection as this Mac's Metal gives it
#   compiler_repro_test         one device failure's state (manual: it takes the state by --test_env)
#   compiler_transient_test     one compile of the heaviest states at its peak
[host_test(
    name = name,
    size = size,
    srcs = [
        name + ".cpp",
        "compiler_requests.h",
        "//drivers/TegraGM20BMetal:raw/pack/kernel_shapes.h",
        "//drivers/TegraGM20BMetal:raw/pack/probe_states.h",
        "//gpu:translate_host",
    ] + headers + RAW_HOST_HEADERS,
    copts = [
        "-x",
        "objective-c++",
        "-fobjc-arc",
    ] + RAW_HOST_COPTS + defines,
    cxx_std = "c++17",
    data = data + [
        "@ipsw//:crawl_qc",
        "@ipsw//:crawl_tree",
    ],
    env = env | {"SWITCH_QUARTZCORE": "$(rootpath @ipsw//:crawl_qc)"},
    linkopts = FACADE_LINKOPTS,
    sanitize = False,
    tags = tags,
    deps = [
        ":raw_facade_plugin_host",
        ":raw_runtime_plugin_host",
    ] + RAW_HOST_DEPS,
) for name, size, tags, headers, defines, data, env in [
    (
        "compiler_compile_only_test",
        "medium",
        [],
        ["reflection_compare.h"],
        select({
            # the corpus's states of private linked functions are iOS 27's libraries' alone, and so is a refused state:
            # iOS 27's PencilKit made sixChannelBlend's constant 6 a bool where iOS 17's states set a uint. iOS 17's
            # libraries refuse none of the corpus states the test can ask of them. (copts are Bourne-tokenized: the
            # single quotes keep the string's.)
            "//ipsw:24B119": [
                "-DSWITCH_LIBRARIES_LINK_PRIVATE_FUNCTIONS=1",
                "'-DSWITCH_REFUSED_FRAGMENT_FUNCTION=\"sixChannelBlend_fragment\"'",
            ],
            "//conditions:default": [],
        }),
        ["//drivers/TegraGM20BMetal:precompile/corpus.log"],
        {"SWITCH_CORPUS": "$(rootpath //drivers/TegraGM20BMetal:precompile/corpus.log)"},
    ),
    (
        "compiler_repro_test",
        "medium",
        ["manual"],
        [],
        [],
        [],
        {},
    ),
    (
        "compiler_transient_test",
        "large",
        [],
        [],
        [],
        ["//drivers/TegraGM20BMetal:precompile/corpus.log"],
        {"SWITCH_CORPUS": "$(rootpath //drivers/TegraGM20BMetal:precompile/corpus.log)"},
    ),
]]

