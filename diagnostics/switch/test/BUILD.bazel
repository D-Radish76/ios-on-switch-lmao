# diagnostics/switch on the host:
#   switch_diag_release_test  SwitchDiag.h as release and debug kernels include it: in release every debug hook is a
#                             macro that never evaluates its arguments, in debug a function; the HUD is built for debug
#                             kernels only
#   switch_diag_link_test     the selected kind's libSwitchDiag and kernel under this build's profile: in release no debug
#                             unit, symbol or text, in every config the panic record and the root boot
#   early_trace_test          start.s's SWITCH_EARLY_MARK under --//kernel:early_trace: scratch registers, framebuffer
#                             range, the flag reaching start.s only, WDT4 armed only in debug kernels
#   stop_path_source_test     the facts ERISTA_STOP_PATHS.md rests on: the spin after halt, who installs the halt hook, the
#                             PSCI conduit's conditions, which paths arm the watchdog reset
#   random_seed_source_test   the order of the first random-seed consumers and the gates ERISTA_RANDOM_SEED.md rests on
#   sd_audit_source_test      the SD driver facts ERISTA_FIRST_XNU_BOOT.md's audit rests on: PMIC writers, the HIDREV skip, the
#                             partition gate, the extension-register writes
#
#   bazel test //diagnostics/switch/test:all
#   bazel test --config=release //diagnostics/switch/test:switch_diag_link_test
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

host_library(
    name = "debug_view",
    srcs = [
        "switch_diag_debug_view.c",
        "//diagnostics/switch:SwitchDiag.h",
    ],
    hdrs = ["switch_diag_debug_view.h"],
    defines = [
        "DEVELOPMENT=1",
        "SWITCH_XNU_BOARD=1",
        "XNU_SWITCH_VERIFIED_ROOT=1",
    ],
)

host_test(
    name = "switch_diag_release_test",
    srcs = [
        "switch_diag_release_test.cpp",
        "//diagnostics/switch:SwitchDiag.h",
    ],
    data = ["//diagnostics/switch:SwitchDiagHud.c"],
    defines = [
        "SWITCH_XNU_BOARD=1",
        "XNU_SWITCH_VERIFIED_ROOT=1",
    ],
    deps = [":debug_view"],
)

py_test(
    name = "switch_diag_link_test",
    srcs = ["switch_diag_link_test.py"],
    args = select({
        "//bazel:release": ["--profile=release"],
        "//conditions:default": ["--profile=debug"],
    }) + [
        "--archive=$(rootpath //kernel:libSwitchDiag)",
    ] + select({
        "//kernel:xnu_12377_121_6": ["--kernel=$(rootpath //kernel:kernel_unprelinked_12377)"],
        "//conditions:default": ["--kernel=$(rootpath //kernel:kernel_unprelinked)"],
    }),
    data = ["//kernel:libSwitchDiag"] + select({
        "//kernel:xnu_12377_121_6": ["//kernel:kernel_unprelinked_12377"],
        "//conditions:default": ["//kernel:kernel_unprelinked"],
    }),
)

py_test(
    name = "early_trace_test",
    srcs = ["early_trace_test.py"],
    data = [
        "//diagnostics/switch:SwitchDiag.c",
        "//drivers/NativeSwitchWatchdog:NativeSwitchWatchdog.cpp",
        "//kernel:build_file",
        "//kernel/switch:objects.bzl",
        "//kernel/xnu-10063.141.1/config:xnu_objects.bzl",
        "//kernel/xnu-10063.141.1/osfmk:arm64/start.s",
        "//kernel/xnu-12377.121.6/config:xnu_objects.bzl",
        "//kernel/xnu-12377.121.6/osfmk:arm64/start.s",
    ],
)

py_test(
    name = "stop_path_source_test",
    srcs = ["stop_path_source_test.py"],
    data = [
        "//kernel:lint_sources",
        "//kernel/xnu-10063.141.1/iokit:Kernel/IOPlatformExpert.cpp",
        "//kernel/xnu-10063.141.1/osfmk:arm64/machine_routines.c",
        "//tools/package:sources",
    ],
)

py_test(
    name = "random_seed_source_test",
    srcs = ["random_seed_source_test.py"],
    data = [
        "//boot:all_sources",
        "//boot:build_file",
        "//diagnostics/switch:SwitchRootBoot.c",
        "//drivers/TegraSE:TegraSE.cpp",
        "//kernel/xnu-10063.141.1/osfmk:arm/arm_init.c",
        "//kernel/xnu-10063.141.1/osfmk:arm64/arm_vm_init.c",
        "//kernel/xnu-10063.141.1/osfmk:prng/prng_random.c",
        "//kernel/xnu-10063.141.1/pexpert:gen/pe_gen.c",
        "//kits/SwitchBoard:SwitchBoard.h",
    ],
)


py_test(
    name = "sd_audit_source_test",
    srcs = ["sd_audit_source_test.py"],
    data = ["//drivers/NativeSwitchBlock:NativeSwitchBlock.cpp"],
)
