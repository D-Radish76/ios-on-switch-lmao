# The Hekate boot entry: what goes to the SD card's FAT (switchroot/ios/*, bootloader/ini/ios.ini,
# bootloader/res/icon_ios_hue.bmp) and the userland overlay the deploy copies to Data (overlay/<absolute path>).
#
#   bazel build //:boot          -> bazel-bin/boot/ios/   (the CMake flow's out/boot/ios)
#
# Boot-args (COMMAND_LINE) live in tools/package/boot_args.py; the ADT edits, USB_HOST and DISPLAY_GAMUT in
# tools/package/adt_edit.py; the steps and what each reads in boot/defs.bzl.
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "bool_setting")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:inputs.bzl", "tool_output")
load(":package.bzl", "boot_entry")
load(":diag/loader.bzl", "diag_loader_package")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# Four cores: adt_edit.py --smp's four-A57 ADT.
SMP = True

bool_flag(
    name = "smp",
    build_setting_default = SMP,
)

# What the release is built with (its CI sets no --//boot:smp), and so what a package composed from it has.
bool_setting(
    name = "release_smp",
    build_setting_default = SMP,
)

# The Erista's package is single core whatever --//boot:smp says.
bool_setting(
    name = "single_core",
    build_setting_default = False,
)

# The GPU bundle's trust cache module, appended to the kernel's static trust cache so the plugin may run.
# --//boot:gpu_trustcache=//boot:no_gpu packages without it (what the CMake flow did when out/gpu was absent).
label_flag(
    name = "gpu_trustcache",
    build_setting_default = ":default_gpu_trustcache",
)

alias(
    name = "default_gpu_trustcache",
    actual = select({
        "//install:from_release": "@switch_release//:gpu_trustcache",
        "//conditions:default": "//gpu:trustcache",
    }),
)

# fetchform and the hardware test apps are a debug build's, so never in a package composed from the release (release
# builds), which also keeps rules_apple, Swift and the Metal toolchain out of the Xcode-free image path.
selects.config_setting_group(
    name = "local_debug",
    match_all = [
        "//bazel:debug",
        "//install:from_local",
    ],
)

# Each IPSW kind's debug image carries the hardware test app built for its iOS version (apps/hwtest/BUILD.bazel).
[
    selects.config_setting_group(
        name = "local_debug_" + kind,
        match_all = [
            "//bazel:debug",
            "//install:from_local",
            "//ipsw:" + kind,
        ],
    )
    for kind in ("21H461", "24B119")
]

filegroup(
    name = "no_gpu",
    srcs = [],
)

_ADT_SEED = ""

# The board ADT, generated, with its random seed pinned: the CMake flow's 64 bytes (passes/native-root-memory-v1/
# full-ram.adt), then 192 more for xnu-12377's 256 (boot/loader/seed.h).
tool_output(
    name = "adt",
    outs = ["full-ram.adt"],
    args = [
        _ADT_SEED,
        "{out}",
    ],
    binary = "//tools/package:adt",
    message = "Generating the native OLED ADT",
    xcode = False,
)

# The Erista's base tree (one core), for tools/package/adt_check.py and the Erista edit test. Not in any package.
tool_output(
    name = "erista_adt",
    outs = ["erista-full-ram.adt"],
    args = [
        _ADT_SEED,
        "{out}",
    ],
    binary = "//tools/package:erista_adt",
    message = "Generating the native Erista ADT",
    xcode = False,
)

# The Erista's tree with a per-install seed from local/erista-seed.hex (tools/package/erista_seed.py generate), which git
# ignores. Without the file the target does not build. no-remote and no-cache keep this action's output out of any cache;
# the actions after it depend on the seed too, so build with the flags erista_seed.py command prints.
tool_output(
    name = "erista_adt_seeded",
    srcs = ["//local:erista-seed.hex"],
    outs = ["erista-full-ram-seeded.adt"],
    args = [
        "$(execpath //local:erista-seed.hex)",
        "{out}",
    ],
    binary = "//tools/package:erista_adt_seeded",
    message = "Generating the native Erista ADT with the per-install seed",
    requirements = [
        "no-cache",
        "no-remote",
    ],
    xcode = False,
)

# hekate passes every key to U-Boot's environment too. bootwait=0: no wait on hekate's logo when launched from Nyx.
# scan_dev_for_extlinux: the first boot timing sample (boot/loader/stamps.h). bootcmd_mmc0=true: never scan the eMMC.
write_file(
    name = "ios_ini",
    out = "ios.ini",
    content = [
        "[iOS]",
        "l4t=1",
        "boot_prefixes=/switchroot/ios/",
        "id=iOS",
        "icon=bootloader/res/icon_ios_hue.bmp",
        "logopath=switchroot/ios/bootlogo.bmp",
        "bootwait=0",
        "scan_dev_for_extlinux=setexpr.l ios_uboot *0x60005010",
        "bootcmd_mmc0=true",
        "",
    ],
    newline = "unix",
)

# --//install:prebuilt=release takes the release's kernel, overlay Mach-Os, GPU trust cache, lz4 and loader, with the
# release's --//boot:smp (boot/package.bzl).
boot_entry(
    name = "package",
    adt = ":adt",
    dtb = "//bazel/pinned:firmware/oled-sku3.dtb",
    smp = select({
        "//install:from_release": ":release_smp",
        "//conditions:default": ":smp",
    }),
)

# The Erista's entry (ERISTA_NATIVE_PORT_PLAN.md, N5): its own ADT, DTB and directory, one core. Building it boots
# nothing: the Erista row is boot 0, so the script and the loader refuse an Erista console, and its tree is checked by
# //tools/package/test:erista_package_test. Opt in (manual). Under the release's prebuilt parts, which were made for the OLED's
# window, bl33 stage refuses it (constants.json differs).
boot_entry(
    name = "erista_package",
    adt = ":erista_adt",
    dtb = "//bazel/pinned:firmware/erista-sku0.dtb",
    out = "erista-ios",
    smp = ":single_core",
    tags = ["manual"],
)

# The Erista's first-XNU observation package (ERISTA_FIRST_XNU_BOOT.md): erista_package under a directory of its own, so a
# build with --//kernel:early_trace=true cannot overwrite the plain one. The flag, not this target, makes the kernel draw
# its stage marks. Still boot 0: both stages refuse an Erista console.
boot_entry(
    name = "erista_first_xnu",
    adt = ":erista_adt",
    dtb = "//bazel/pinned:firmware/erista-sku0.dtb",
    out = "erista-first-xnu",
    require_early_trace = True,
    stop_after_vm = True,
    smp = ":single_core",
    tags = ["manual"],
)

# erista_first_xnu with the per-install seed: its own directory, never built by default.
boot_entry(
    name = "erista_first_xnu_seeded",
    adt = ":erista_adt_seeded",
    dtb = "//bazel/pinned:firmware/erista-sku0.dtb",
    out = "erista-first-xnu-seeded",
    private_seed = True,
    require_early_trace = True,
    stop_after_vm = True,
    smp = ":single_core",
    tags = ["manual"],
)

# What the loader would link to once the Erista's row boots and brings its MC values (carveout.h, every row's values
# in). Only its loader.uboot.bin is exposed, so there is no package to put on a card: a build that links is a loader
# below the stamps slot (link.ld ASSERT).
boot_entry(
    name = "erista_rows_work",
    adt = ":erista_adt",
    dtb = "//bazel/pinned:firmware/erista-sku0.dtb",
    loader_defines = ["-DSWITCH_CARVEOUT_ALL_ROWS=1"],
    out = "erista-rows-unused",
    smp = ":single_core",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "erista_loader_all_rows",
    srcs = [":erista_rows_work"],
    output_group = "loader",
)

# The loader and the window constants it was compiled for (constants.json: layout.h's and runs.h's), which the release
# ships (//install:release_inputs) though they were made from the IPSW's kernelcache: release/ipsw_free.bzl DECLASSIFIED.
filegroup(
    name = "loader",
    srcs = [":package"],
    output_group = "loader",
)

# The D0 loader diagnostic (boot/diag/loader/README.md): its own loader, bl33.bin and hekate entry for an Erista. It
# shares no output with :package and carries no kernel window.
diag_loader_package(
    name = "diag_loader",
    srcs = [
        ":diag/loader/entry.S",
        ":diag/loader/diag.c",
        ":diag/loader/checks.c",
        ":diag/loader/report.c",
        ":diag/loader/exit.c",
        ":loader/memory.c",
    ],
    hdrs = [
        ":diag/loader/checks.h",
        ":diag/loader/diag.h",
        ":diag/loader/mc_table.h",
        ":diag/loader/ranges.h",
        ":diag/loader/report.h",
        ":handoff/display.h",
        ":handoff/entry.S",
        ":handoff/record.h",
        ":loader/memory.h",
        ":loader/ram.h",
        "//kits/SwitchBoard:SwitchBoard.h",
    ],
    include_markers = [
        ":diag/loader/checks.h",
        ":handoff/record.h",
        ":loader/memory.h",
        "//kits/SwitchBoard:SwitchBoard.h",
    ],
    bl31 = "//bazel/pinned:firmware/bl31.bin",
    bl33 = "//bazel/pinned:firmware/bl33.bin",
    board = "erista",
    dtb = "//bazel/pinned:firmware/erista-sku0.dtb",
    linker_script = ":diag/loader/link.ld",
    script_template = ":diag/loader/u-boot-script.txt",
    xcode_env = "@xcode//:xcode.env",
    xcode_identity = "@xcode//:identity",
)

# D0-R: the D0 loader's sources, a flag and one more file (diag/loader/reservations.c). Its screen also lists the FDT's banks
# and every reserved range, and checks the exporter's run area and the SD reference page against them. It is its own entry
# (iOS Diag Loader R) and leaves :diag_loader's outputs as they are.
diag_loader_package(
    name = "diag_loader_r",
    srcs = [
        ":diag/loader/entry.S",
        ":diag/loader/diag.c",
        ":diag/loader/checks.c",
        ":diag/loader/report.c",
        ":diag/loader/reservations.c",
        ":diag/loader/exit.c",
        ":loader/memory.c",
    ],
    hdrs = [
        ":diag/loader/checks.h",
        ":diag/loader/diag.h",
        ":diag/loader/mc_table.h",
        ":diag/loader/ranges.h",
        ":diag/loader/report.h",
        ":diag/loader/reservations.h",
        ":handoff/display.h",
        ":handoff/entry.S",
        ":handoff/record.h",
        ":loader/memory.h",
        ":loader/ram.h",
        "//kits/SwitchBoard:SwitchBoard.h",
    ],
    bl31 = "//bazel/pinned:firmware/bl31.bin",
    bl33 = "//bazel/pinned:firmware/bl33.bin",
    board = "erista",
    defines = ["-DSWITCH_DIAG_RESERVATIONS=1"],
    dtb = "//bazel/pinned:firmware/erista-sku0.dtb",
    entry = "ios-diag-loader-r",
    ident = "iDiagLR",
    include_markers = [
        ":diag/loader/checks.h",
        ":handoff/record.h",
        ":loader/memory.h",
        "//kits/SwitchBoard:SwitchBoard.h",
    ],
    linker_script = ":diag/loader/link.ld",
    script_template = ":diag/loader/u-boot-script.txt",
    title = "iOS Diag Loader R",
    xcode_env = "@xcode//:xcode.env",
    xcode_identity = "@xcode//:identity",
)

