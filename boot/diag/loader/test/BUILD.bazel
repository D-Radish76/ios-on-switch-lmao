# The D0 loader diagnostic (boot/diag/loader) on the host: its precondition checks and screen text.
#
#   bazel test //boot/diag/loader/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

host_library(
    name = "checks",
    srcs = [
        "//boot:diag/loader/checks.c",
        "//boot:diag/loader/checks.h",
        "//boot:diag/loader/mc_table.h",
        "//boot:diag/loader/report.c",
        "//boot:diag/loader/report.h",
    ],
    copts = ["-O1"],
)

host_test(
    name = "diag_checks_test",
    srcs = ["diag_checks_test.cpp"],
    deps = [":checks"],
)

host_library(
    name = "reservations",
    srcs = [
        "//boot:diag/loader/report.c",
        "//boot:diag/loader/report.h",
        "//boot:diag/loader/reservations.c",
        "//boot:diag/loader/reservations.h",
        "//boot:loader/ram.h",
    ],
    copts = ["-O1"],
)

host_test(
    name = "reservations_test",
    srcs = ["reservations_test.cpp"],
    deps = [":reservations"],
)

host_library(
    name = "t1",
    srcs = [
        "//boot:diag/loader/report.c",
        "//boot:diag/loader/report.h",
        "//boot:diag/loader/t1.c",
        "//boot:diag/loader/t1.h",
        "//boot:diag/loader/t1_gate.c",
        "//boot:diag/loader/t1_regs.c",
        "//boot:diag/loader/t1_report.c",
        "//boot:diag/loader/t1_report.h",
    ],
    copts = ["-O1"],
)

host_test(
    name = "t1_test",
    srcs = ["t1_test.cpp"],
    deps = [":t1"],
)
