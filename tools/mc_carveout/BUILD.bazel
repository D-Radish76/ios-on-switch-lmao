load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(["dump.sh"])

# dump.sh against a fake devmem, and its register table against boot/loader/loader.c.
py_test(
    name = "test_dump",
    size = "small",
    srcs = ["test_dump.py"],
    data = [
        "dump.sh",
        "//boot:loader/loader.c",
    ],
)
